data/raw/
# local toolchain and environment (never committed)
.tools/
.venv/
__pycache__/
*.pyc
.pytest_cache/
# derived artefacts
data/processed/
indexes/
models/

# local spreadsheets and their Excel lock files
*.xlsx
~$*

# dev evaluation outputs (final_*.json stays committable)
results/eval/*_dev.json
results/eval/*_dev_confidence.json

# local rules file (not published)
CLAUDE.md

# upload copies (not published)
linaw-*.md

# local question and result files (not published)
/dost_questions.txt
/dost_results.txt

# question files: only the frozen test split is committed
eval/questions/*
!eval/questions/test.jsonl
!eval/questions/test.sha256

# R session history
.Rhistory
